# Doxygen configuration for mirs ROS 2 package.
# Usage: `doxygen Doxyfile` -> static HTML/XML under docs/generated (no server needed).
# Convention: lightweight Doxygen (brief/param/return) on public API only.

PROJECT_NAME           = "mirs"
OUTPUT_DIRECTORY       = docs/generated
INPUT                  = README.md src scripts launch
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.hpp *.py
EXCLUDE_PATTERNS       = */test/* */__pycache__/*

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = YES
GENERATE_DOCBOOK       = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
QUIET                  = YES
